{
  "name": "obs-effects",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "npm run dev",
    "build": "npm run lint && npm run check:effects-meta && tsc && vite build",
    "check:effects-meta": "npm run test:effects-meta && npm run check:effects-meta:fresh && node scripts/check-effects-meta.js",
    "check:effects-meta:fresh": "node scripts/gen-metadata.js --check",
    "test": "npm run test:effects-meta",
    "test:effects-meta": "node scripts/test-effects-meta.js",
    "lint": "eslint .",
    "dev": "vite"
  },
  "dependencies": {
    "@esotericsoftware/spine-pixi-v8": "^4.2.110",
    "@pixi/sound": "^6.0.1",
    "gsap": "^3.15.0",
    "motion": "^12.40.0",
    "pixi.js": "^8.19.0",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@assetpack/core": "^1.4.0",
    "@eslint/js": "^10.0.1",
    "@types/three": "^0.184.1",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.2",
    "eslint-plugin-prettier": "^5.2.6",
    "prettier": "^3.5.3",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.25.0",
    "vite": "^8.0.16"
  }
}
